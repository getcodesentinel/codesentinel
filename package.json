{
  "name": "codesentinel-workspace",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "scripts": {
    "build": "pnpm -r --filter \"!./packages/cli\" build && pnpm --filter ./packages/cli build",
    "start": "pnpm --filter ./packages/cli exec node dist/index.js",
    "start:dev": "pnpm --filter ./packages/cli dev",
    "dev": "pnpm -r --filter \"!./packages/cli\" build && pnpm --filter ./packages/cli dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r --filter './packages/*' exec tsc --noEmit -p tsconfig.json",
    "lint:staged": "lint-staged",
    "verify": "pnpm build && pnpm typecheck && pnpm test",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "prepare": "husky",
    "release": "semantic-release",
    "test": "pnpm -r test",
    "publish:cli": "pnpm --filter ./packages/cli exec npm publish --access public",
    "verify:cli-package": "node scripts/verify-cli-package.mjs",
    "verify:mcp-package": "node scripts/verify-mcp-package.mjs",
    "verify:mcp": "npx -y @modelcontextprotocol/inspector --cli node packages/cli/dist/index.js mcp --method tools/list"
  },
  "lint-staged": {
    "*.{cjs,css,cts,html,js,json,md,mjs,mts,scss,ts,tsx,yaml,yml}": "prettier --write",
    "*.{cjs,cts,js,mjs,mts,ts,tsx}": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "conventional-changelog-conventionalcommits": "^9.0.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "prettier": "^3.8.3",
    "semantic-release": "^25.0.3",
    "tsup": "^9.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
