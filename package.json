{
  "name": "codesentinel-workspace",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.4+sha512.8768be55200ae3f2226b6527fcca2687e14bc4e5f12d7721a0f25da3df47915177058648db4177baf348120fa0ba2752d8d8d93f6beaf1fe64ae18da8de961af",
  "scripts": {
    "build": "pnpm -r --filter \"!./packages/cli\" build && pnpm --filter ./packages/cli build",
    "start": "pnpm --filter ./packages/cli exec node dist/index.js",
    "start:dev": "pnpm --filter ./packages/cli dev",
    "dev": "pnpm -r --filter \"!./packages/cli\" build && pnpm --filter ./packages/cli dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r --filter './packages/*' exec tsc --noEmit -p tsconfig.json",
    "lint:staged": "lint-staged",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "prepare": "husky",
    "release": "semantic-release",
    "test": "pnpm -r test",
    "publish:cli": "pnpm --filter ./packages/cli exec npm publish --access public",
    "verify:cli-package": "node scripts/verify-cli-package.mjs"
  },
  "lint-staged": {
    "*.{cjs,css,cts,html,js,json,md,mjs,mts,scss,ts,tsx,yaml,yml}": "prettier --write",
    "*.{cjs,cts,js,mjs,mts,ts,tsx}": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "conventional-changelog-conventionalcommits": "^10.0.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "prettier": "^3.8.3",
    "semantic-release": "^25.0.3",
    "tsup": "^8.2.4",
    "tsx": "^4.19.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
