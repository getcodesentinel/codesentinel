{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Weekly batch on Monday, 04:00–05:59 Europe/Madrid. The schedule is the window in which Renovate may create pull requests, not a start time, so it has to be wide enough for a hosted run to land inside it: a single hour was too narrow, and a whole-day window is noisier than intended.",
  "extends": ["config:recommended", ":semanticCommits", ":dependencyDashboard"],
  "assignees": ["aleixalonso"],
  "prConcurrentLimit": 10,
  "rebaseWhen": "behind-base-branch",
  "timezone": "Europe/Madrid",
  "schedule": ["* 4-5 * * 1"],
  "ignoreDeps": [
    "@codesentinel/code-graph",
    "@codesentinel/core",
    "@codesentinel/dependency-firewall",
    "@codesentinel/git-analyzer",
    "@codesentinel/governance",
    "@codesentinel/health-engine",
    "@codesentinel/ownership",
    "@codesentinel/reporter",
    "@codesentinel/risk-engine"
  ],
  "packageRules": [
    {
      "matchDepNames": ["undici"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "github-actions dependencies"
    },
    {
      "matchPackageNames": [
        "vitest",
        "tsx",
        "eslint",
        "@typescript-eslint/eslint-plugin",
        "@typescript-eslint/parser",
        "prettier"
      ],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "lint and test tooling"
    },
    {
      "matchPackageNames": [
        "vite",
        "@vitejs/plugin-react",
        "postcss",
        "autoprefixer",
        "tailwind-merge"
      ],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "frontend build tooling"
    },
    {
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true
    }
  ]
}
